# ============================================================
# PCA9685 CONFIGURATION
# ============================================================

PCA9685_ADDRESS = 0x40

# Software I2C bus:
# GPIO17 = SDA
# GPIO27 = SCL
I2C_BUS = 3

PWM_FREQUENCY = 50

# Same oscillator frequency used in your Arduino code
OSCILLATOR_FREQUENCY = 27000000

# Servo pulse range
PWM_MIN_US = 1200
PWM_MAX_US = 2400

# PCA9685 registers
MODE1 = 0x00
MODE2 = 0x01
PRESCALE = 0xFE
LED0_ON_L = 0x06


# ============================================================
# SHARED I2C LOCK AND BUS
# ============================================================

# Prevent OLED and PCA9685 transactions from overlapping.
I2C_LOCK = threading.RLock()
bus = SMBus(I2C_BUS)


