# ============================================================
# PCA9685 INITIALIZATION
# ============================================================

def init_pca9685():

    print("Initializing PCA9685...")

    # Sleep mode
    bus.write_byte_data(
        PCA9685_ADDRESS,
        MODE1,
        0x10
    )

    # Calculate prescale
    prescale = int(
        OSCILLATOR_FREQUENCY /
        (4096 * PWM_FREQUENCY) - 1
    )

    print("PCA9685 prescale:", prescale)

    bus.write_byte_data(
        PCA9685_ADDRESS,
        PRESCALE,
        prescale
    )

    # Wake up
    bus.write_byte_data(
        PCA9685_ADDRESS,
        MODE1,
        0x00
    )

    time.sleep(0.005)

    # Auto increment enabled
    bus.write_byte_data(
        PCA9685_ADDRESS,
        MODE1,
        0x20
    )

    # Output driver configuration
    bus.write_byte_data(
        PCA9685_ADDRESS,
        MODE2,
        0x04
    )

    time.sleep(0.01)

    print("PCA9685 initialized successfully")


# ============================================================
# ANGLE -> PCA9685 PWM
# ============================================================

def angle_to_pulse(angle):

    # Limit angle
    angle = max(0, min(180, angle))

    # Convert angle to microseconds
    pulse_us = (
        PWM_MIN_US
        + (angle / 180.0)
        * (PWM_MAX_US - PWM_MIN_US)
    )

    # Convert microseconds to PCA9685 counts
    pulse = int(
        (pulse_us * 4096) / 20000
    )

    return pulse


# ============================================================
# SAFE I2C WRITE
# ============================================================

def i2c_write_block(register, data, retries=3):

    for attempt in range(retries):

        try:

            bus.write_i2c_block_data(
                PCA9685_ADDRESS,
                register,
                data
            )

            return True

        except OSError as e:

            print(
                f"I2C error on register 0x{register:02X}, "
                f"attempt {attempt + 1}/{retries}: {e}"
            )

            if attempt < retries - 1:

                time.sleep(0.01)

            else:

                raise


# ============================================================
# WRITE 8 PCA9685 CHANNELS
# ============================================================

def write_8_channels(start_channel, angles):

    data = []

    for angle in angles:

        pulse = angle_to_pulse(angle)

        # ON = 0
        on_low = 0
        on_high = 0

        # OFF = pulse
        off_low = pulse & 0xFF
        off_high = (pulse >> 8) & 0x0F

        data.append(on_low)
        data.append(on_high)
        data.append(off_low)
        data.append(off_high)

    # Starting register
    register = LED0_ON_L + (4 * start_channel)

    # 8 channels x 4 bytes = 32 bytes
    i2c_write_block(register, data)


# ============================================================
# UPDATE ALL 16 SERVOS
# ============================================================

def update_servos():

    angles = [
        s0, s1,
        s2, s3,
        s4, s5,
        s6, s7,
        s8, s9,
        s10, s11,
        s12, s13,
        s14, s15
    ]

    # Keep both channel groups together so OLED refreshes cannot
    # interrupt a multi-channel servo update on the shared I2C bus.
    with I2C_LOCK:
        write_8_channels(0, angles[0:8])
        time.sleep(0.002)
        write_8_channels(8, angles[8:16])


